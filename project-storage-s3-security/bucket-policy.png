{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "EnforceHTTPSConnections",
            "Effect": "Deny",
            "Principal": "*",
            "Action": "s3:*",
            "Resource": [
                "arn:aws:s3:::secure-audit-lab-devops-gw",
                "arn:aws:s3:::secure-audit-lab-devops-gw/*"
            ],
            "Condition": {
                "Bool": {
                    "aws:SecureTransport": "false"
                }
            }
        }
    ]
}
